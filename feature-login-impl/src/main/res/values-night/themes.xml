<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Базовая тема приложения, обновленная до Material 3 -->
    <style name="Theme.DatingApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Основной цвет бренда -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Вторичный цвет бренда -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Цвет статус-бара (привязан к основному цвету приложения) -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>
</resources>